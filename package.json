{
  "name": "pyeongchang-in-miniature",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data:fetch": "node scripts/fetch-osm.mjs",
    "test": "node tests/browser.mjs",
    "data:process": "python scripts/parse-osm.py && node scripts/process-osm.mjs",
    "test:planner": "node --test tests/planner.test.mjs tests/planner-server.test.mjs",
    "test:planner:browser": "node tests/planner-browser.mjs",
    "test:planner:api": "node tests/planner-api.mjs",
    "db:transit": "node scripts/transit-db.mjs",
    "test:transit": "node --test tests/transit-store.test.mjs",
    "test:world": "node tests/world-browser.mjs",
    "maps:fetch": "node scripts/fetch-regions.mjs",
    "maps:process": "python scripts/process-regions.py",
    "test:jitter": "node tests/jitter-browser.mjs",
    "test:rail": "node --test tests/rail-schedule.test.mjs",
    "test:portals-trains": "node tests/portals-trains-browser.mjs",
    "data:rail": "python scripts/process-rail-timetable.py",
    "test:docs": "node scripts/check-doc-links.mjs",
    "data:rail:fetch": "python scripts/fetch-rail-timetable.py",
    "test:train-motion": "node --test tests/train-journey.test.mjs",
    "test:train-motion:browser": "node tests/train-journey-browser.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
